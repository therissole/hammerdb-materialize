RDBMS=MSSQL

# Set REMOTE_DB=true to target a pre-existing remote MSSQL instance (e.g. in AKS).
# When true, run_tprocc_cycle.ps1 will:
#   - Skip tearing down / recreating the local DB Docker container
#   - Skip the local DB healthcheck
#   - Skip Materialize setup (configure that separately once remote DB is working)
#   - Only start the local hammerdb container and point it at the remote host
#   - Require RDBMS=MSSQL (remote PGSQL is not enabled in this first pass)
# If you use kubectl port-forward to local loopback, keep MSSQL_HOST=127.0.0.1 and set
# MSSQL_HOST_FROM_CONTAINER=host.docker.internal so hammerdb container can reach it.
REMOTE_DB=false
MSSQL_HOST_FROM_CONTAINER=host.docker.internal

POSTGRES_HOST=postgres
POSTGRES_DB=tpcc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

MSSQL_HOST=mssql
MSSQL_PORT=1433
MSSQL_DB=tpcc
MSSQL_USER=sa
MSSQL_SA_PASSWORD=YourStrong!Passw0rd
# Optional explicit admin credential used only for remote DB bootstrap (drop/create DB, create logins/users).
# Defaults to MSSQL_USER / MSSQL_SA_PASSWORD.
MSSQL_ADMIN_USER=
MSSQL_ADMIN_PASSWORD=
# Optional separate SQL login for Materialize source connection. Defaults to MSSQL_USER / MSSQL_SA_PASSWORD.
MSSQL_MZ_USER=
MSSQL_MZ_PASSWORD=
MSSQL_USE_BCP=false

HAMMERDB_IMAGE=tpcorg/hammerdb:latest
MATERIALIZED_IMAGE=materialize/materialized:latest
MATERIALIZE_SQL_PORT=6875

PG_SSLMODE=prefer
TPCC_USER=tpcc
TPCC_PASS=tpcc

TPROC_C_WAREHOUSES=
TPROC_C_VU=
TPROC_C_RAMPUP=2
TPROC_C_DURATION=5
TPROC_C_ALLWAREHOUSE=true
TPROC_C_PROFILEID=0
TPROC_C_UAW=0
